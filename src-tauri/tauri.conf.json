{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XSTIFY",
  "version": "0.1.2",
  "identifier": "com.xstify.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "XSTIFY",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 500,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling,MediaSessionService",
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5QTVDNUREMTgyNTA4MzAKUldRd0NDVVkzY1dsdWZob3UxVTR4bmJSbExhVXhQcUhTOGlyRXBLMDE5elRmS3AzK0hVVU9wTEEK",
      "endpoints": [
        "https://github.com/rxst0/XSTIFY/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
